[Unit]
Description=pi-web — browser-based pi session viewer and chat
Documentation=https://github.com/tajquitgenius/pi-web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pi-web
Restart=on-failure
RestartSec=5

# Load pi-web configuration, including PI_WEB_REMOTE_AUTH, when set.
EnvironmentFile=-%h/.config/pi-web/env

[Install]
WantedBy=default.target
