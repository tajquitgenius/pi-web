# Copy to ~/.config/pi-web/env on the personal host only.
# Replace the token placeholder with a value generated on this host. Never commit the result.
PI_WEB_INSTANCE_NAME='Personal'
PI_WEB_PUBLIC_URL=https://personal.pi.tajwar.org
PI_WEB_PEERS_JSON='[{"label":"Work","url":"https://work.pi.tajwar.org"},{"label":"Cloud","url":"https://cloud.pi.tajwar.org"}]'
PI_WEB_TOKEN=REPLACE_WITH_A_UNIQUE_VALUE_GENERATED_ON_THIS_HOST
