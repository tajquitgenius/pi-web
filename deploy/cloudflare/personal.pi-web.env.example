# Copy to ~/.config/pi-web/env on the personal host only.
# Cloudflare Access is the sole remote gate in external mode. Never expose the origin directly.
# PI_WEB_TOKEN is optional after Cloudflare Access. Never commit the result.
PI_WEB_INSTANCE_NAME='Personal'
PI_WEB_PUBLIC_URL=https://personal-pi.tajwar.org
PI_WEB_REMOTE_AUTH=external
# `pi-web node join https://pi.tajwar.org` writes the owner-only hub credential file.
# PI_WEB_TOKEN=REPLACE_WITH_A_UNIQUE_VALUE_GENERATED_ON_THIS_HOST
