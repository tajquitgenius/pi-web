# Copy to ~/.config/pi-web/env on the always-on work-claw server only when the Main cutover is approved.
# Main keeps device pairing so existing phone authentication continues unchanged.
# PI_WEB_TOKEN is optional after Cloudflare Access and pairing. Never commit the resulting file.
PI_WEB_INSTANCE_NAME='Main'
PI_WEB_PUBLIC_URL=https://pi.tajwar.org
PI_WEB_REMOTE_AUTH=pairing
PI_WEB_HUB=1
# PI_WEB_TOKEN=REPLACE_WITH_A_UNIQUE_VALUE_GENERATED_ON_THIS_HOST
