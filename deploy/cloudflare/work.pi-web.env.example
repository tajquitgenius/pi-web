# Copy to ~/.config/pi-web/env on the work host only after company approval.
# Replace the token placeholder with a value generated on this host. Never commit the result.
PI_WEB_INSTANCE_NAME='Work'
PI_WEB_PUBLIC_URL=https://work.pi.tajwar.org
PI_WEB_PEERS_JSON='[{"label":"Personal","url":"https://personal.pi.tajwar.org"},{"label":"Cloud","url":"https://cloud.pi.tajwar.org"}]'
PI_WEB_TOKEN=REPLACE_WITH_A_UNIQUE_VALUE_GENERATED_ON_THIS_HOST
